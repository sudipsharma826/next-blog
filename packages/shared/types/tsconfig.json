{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@shared/types": ["../types/src/index.ts"],
      "@shared/utils": ["../utils/src/index.ts"]
    }
  },
  "include": ["src", "index.ts"]
}
